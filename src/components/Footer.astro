---
import type { Lang } from "../i18n/ui";
import { useTranslations } from "../i18n/ui";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <p class="foot" set:html={t.foot} />

  <div class="footer-bottom">
    <div class="footer-meta">
      <span class="footer-copy">© {year} {t.footerRights}</span>
    </div>

    <a
      href="https://batalshikov.com"
      target="_blank"
      rel="noopener noreferrer"
      class="footer-author-link"
    >
      <span class="link-label">{t.footerBy}</span>
      <strong class="link-name">batalshikov.com</strong>
      <svg class="link-arrow" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="7" y1="17" x2="17" y2="7"></line>
        <polyline points="7 7 17 7 17 17"></polyline>
      </svg>
    </a>
  </div>
</footer>
