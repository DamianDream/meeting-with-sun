---
import { getRelativeLocaleUrl } from "astro:i18n";
import { useTranslations, htmlLang, defaultLocale, locales, type Lang } from "../i18n/ui";
import SunBackground from "../components/SunBackground.astro";
import LangSwitcher from "../components/LangSwitcher.astro";
import "../styles/global.css";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const localeUrls = Object.fromEntries(
  locales.map((code) => [code, getRelativeLocaleUrl(code, "")])
) as Record<Lang, string>;
---

<!doctype html>
<html lang={htmlLang[lang]}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{t.title}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Unbounded:wght@400;700;900&family=Manrope:wght@400;600&family=JetBrains+Mono:wght@400;700&display=swap" />
  <script is:inline define:vars={{ lang, defaultLocale, localeUrls }}>
    (() => {
      const LANG_KEY = "sun-timer-lang";
      const SESSION_KEY = "sun-timer-redirect-checked";
      const stored = localStorage.getItem(LANG_KEY);

      if (lang !== defaultLocale) {
        localStorage.setItem(LANG_KEY, lang);
        return;
      }

      // На дефолтной локали (ru, "/") авто-редирект по сохранённому языку
      // срабатывает не больше раза за сессию вкладки — иначе клик по "RU" в
      // переключателе языка (ведёт на "/") тут же отбрасывал бы обратно на
      // сохранённую локаль, и вернуться на ru вручную было бы невозможно.
      if (sessionStorage.getItem(SESSION_KEY)) {
        localStorage.setItem(LANG_KEY, lang);
        return;
      }
      sessionStorage.setItem(SESSION_KEY, "1");

      if (!stored) {
        const tags = navigator.languages && navigator.languages.length
          ? navigator.languages
          : [navigator.language || ""];
        let target = null;
        for (const tag of tags) {
          const [language, region] = tag.toLowerCase().split("-");
          if (language === "uk" || region === "ua") { target = "ua"; break; }
          if (language === "ru") { target = "ru"; break; }
          if (language === "en") { target = "en"; break; }
        }
        if (target) {
          localStorage.setItem(LANG_KEY, target);
          location.replace(localeUrls[target]);
        } else {
          localStorage.setItem(LANG_KEY, lang);
        }
        return;
      }

      if (stored !== lang && localeUrls[stored]) {
        location.replace(localeUrls[stored]);
      } else {
        localStorage.setItem(LANG_KEY, lang);
      }
    })();
  </script>
</head>
<body>
  <SunBackground />
  <LangSwitcher lang={lang} />
  <main>
    <slot />
  </main>
</body>
</html>
